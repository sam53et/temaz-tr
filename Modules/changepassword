#!/bin/bash

if [[ -f /etc/SSHPlus/colors ]]; then
	source /etc/SSHPlus/colors
elif [[ -f /bin/colors ]]; then
	source /bin/colors
elif [[ -f "$(dirname "$0")/colors" ]]; then
	source "$(dirname "$0")/colors"
fi

if [[ -f /etc/SSHPlus/db ]]; then
	source /etc/SSHPlus/db
elif [[ -f /bin/db ]]; then
	source /bin/db
elif [[ -f "$(dirname "$0")/db" ]]; then
	source "$(dirname "$0")/db"
fi

banner_info "   Kullanıcı Parolasını Değiştir   "
echo ""
color_echo "KULLANICILAR VE PAROLALARI:" "yellow"
echo ""

_user_list=$(awk -F: '$3>=1000 {print $1}' /etc/passwd 2>/dev/null | grep -v nobody)
idx=0
unset _userPass
while read -r _user; do
	[[ -z "$_user" ]] && continue
	((idx++)) || true
	[[ $idx -le 9 ]] && i=0$idx || i=$idx
	_line="$(sshplus_db_get_line "$_user" 2>/dev/null || true)"
	if [[ -z "${_line:-}" ]]; then
		sshplus_with_db_lock sshplus_db_ensure_user "$_user" >/dev/null 2>&1 || true
		_line="$(sshplus_db_get_line "$_user" 2>/dev/null || true)"
	fi
	_pass="$(awk 'NF>=9{rest=$9;for(i=10;i<=NF;i++) rest=rest " " $i; print rest} NF==8{print $8}' <<<"${_line:-}" 2>/dev/null)"
	if [[ -z "${_pass:-}" ]] || [[ "${_pass:-}" == "sha256:UNKNOWN" ]] || [[ "${_pass:-}" == "(not set)" ]]; then
		_pass="(ayarlanmadı)"
	fi
	red_code=$(get_color_code "red")
	cyan_code=$(get_color_code "cyan")
	white_code=$(get_color_code "white")
	green_code=$(get_color_code "green")
	yellow_code=$(get_color_code "yellow")
	reset_code=$(get_reset_code)

	suser="${red_code}[${cyan_code}$i${red_code}] ${white_code}- ${green_code}$_user${reset_code}"
	ssenha="${yellow_code}Parola${white_code}: $_pass${reset_code}"
	echo -e "${suser}  ${ssenha}"
	_userPass+="\n${i}:${_user}"
done <<< "${_user_list}"
num_user=$(awk -F: '$3>=1000 {print $1}' /etc/passwd 2>/dev/null | grep -v nobody | wc -l)
echo ""
menu_option "0" "GERİ" "red" "yellow"
menu_option "00" "ÇIKIŞ" "red" "yellow"
echo ""
color_echo_n "Bir kullanıcı yazın veya seçin " "green"
color_echo_n "[" "yellow"
color_echo_n "1" "cyan"
color_echo_n "-" "red"
color_echo_n "$num_user" "cyan"
color_echo_n "]" "yellow"
color_echo_n ": " "white"
read -r option
option="${option//[[:space:]]/}"
if [[ "$option" == "0" ]]; then
	exit 0
elif [[ "$option" == "00" ]]; then
	exit 99
fi
user=$(echo -e "${_userPass}" | awk -v o="$option" -F: 'NF>=2 && $1+0==o+0 {print $2; exit}')
if [[ -z $option ]]
then
	echo ""
	msg_err "Boş veya geçersiz alan!"
	echo ""
	exit 1
elif [[ -z $user ]]
then
	echo ""
	msg_err "Boş veya geçersiz bir isim girdiniz!"
	echo ""
	exit 1
else
	if [[ `grep -c /$user: /etc/passwd` -ne 0 ]]
	then
		echo ""
		color_echo_n "Kullanıcı için yeni parola " "green"
		color_echo_n "$user" "yellow"
		color_echo_n ": " "white"
		read -r password
		sizepass=$(echo ${#password})
		if [[ $sizepass -lt 4 ]]
		then
			echo ""
			msg_err "Parola boş veya geçersiz! En az 4 karakter kullanın"
			echo ""
			exit 1
		else
			ps x | grep $user | grep -v grep | grep -v pt > /tmp/rem
			if [[ `grep -c $user /tmp/rem` -eq 0 ]]
			then
				if ! sshplus_with_db_lock sshplus_db_set_password "$user" "$password"; then
					echo ""
					msg_err "$user kullanıcısının parolası değiştirilemedi"
					echo ""
					exit 1
				fi
				echo ""
				msg_ok "$user kullanıcısının parolası şu şekilde değiştirildi: $password"
				echo ""
				exit 1
			else
				echo ""
				msg_info "Kullanıcı oturum açmış. Bağlantı kesiliyor..."
				pkill -f $user
				if ! sshplus_with_db_lock sshplus_db_set_password "$user" "$password"; then
					echo ""
					msg_err "$user kullanıcısının parolası değiştirilemedi"
					echo ""
					exit 1
				fi
				echo ""
				msg_ok "$user kullanıcısının parolası şu şekilde değiştirildi: $password"
				echo ""
				exit 1
			fi
		fi
	else
		echo ""
		msg_err "$user kullanıcısı mevcut değil!"
		echo ""
	fi
fi
