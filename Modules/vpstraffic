#!/bin/bash

if [[ -f /etc/SSHPlus/colors ]]; then
	source /etc/SSHPlus/colors
elif [[ -f /bin/colors ]]; then
	source /bin/colors
elif [[ -f "$(dirname "$0")/colors" ]]; then
	source "$(dirname "$0")/colors"
fi

if ! command -v nload &>/dev/null; then
	msg_err "nload kurulu değil. Kurmak için: apt install nload"
	sleep 3
	exit 1
fi
clear
color_echo "Çıkmak için Ctrl+C tuşlarına basın" "green"
sleep 2
exec nload
